{
  "name": "yapd",
  "version": "0.1.0",
  "description": "Your coding agents, out loud.",
  "keywords": [
    "claude-code",
    "codex",
    "text-to-speech",
    "agents",
    "hooks"
  ],
  "homepage": "https://github.com/lg-epitech/yapd#readme",
  "bugs": "https://github.com/lg-epitech/yapd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lg-epitech/yapd.git"
  },
  "license": "MIT",
  "author": "Laurent Gonzalez",
  "type": "module",
  "bin": {
    "yapd": "src/main.ts"
  },
  "files": [
