    "!src/**/*.test.ts"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "start": "bun src/main.ts serve",
    "check": "tsc",
    "test": "bun test"
  },
  "dependencies": {
    "effect": "^3.22.2",
    "kokoro-js": "^1.2.1"
  },
