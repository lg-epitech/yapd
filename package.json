{
  "name": "@launatic/yapd",
  "version": "0.2.0",
  "description": "Your coding agents, out loud.",
  "keywords": [
    "claude-code",
    "codex",
    "text-to-speech",
    "agents",
    "hooks"
  ],
  "homepage": "https://github.com/lg-epitech/yapd#readme",
  "bugs": "https://github.com/lg-epitech/yapd/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lg-epitech/yapd.git"
  },
  "license": "MIT",
  "author": "Laurent Gonzalez",
  "type": "module",
  "bin": {
    "yapd": "src/main.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/main.ts serve",
    "check": "tsc",
    "test": "bun test",
    "app": "xcodebuild -project app/yapd.xcodeproj -configuration Release -quiet install DSTROOT=\"$HOME\" && (pkill -x yapd && sleep 1 || true) && open \"$HOME/Applications/yapd.app\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "effect": "^3.22.2",
    "onnxruntime-node": "1.30.0",
    "phonemizer": "^1.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
